{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "Menu jajanan nusantara dengan status ketersediaan stok, harga, dan level pedas.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik menu" },
        "name": { "type": "string", "description": "Nama menu jajanan", "maxLength": 100 },
        "category": { "type": "string", "enum": ["pedas", "kuah", "gorengan", "minuman", "paket"] },
        "price": { "type": "number", "description": "Harga satuan dalam Rupiah" },
        "description": { "type": "string", "description": "Deskripsi makanan dan bumbu", "maxLength": 500 },
        "image": { "type": "string", "description": "URL foto menu" },
        "isAvailable": { "type": "boolean", "description": "Status ketersediaan stok" },
        "spicyLevelAllowed": { "type": "boolean", "description": "Apakah bisa atur level pedas" },
        "defaultSpicyLevel": { "type": "number", "description": "Level pedas bawaan (0-5)" },
        "prepTimeMinutes": { "type": "number", "description": "Estimasi waktu masak (menit)" },
        "popular": { "type": "boolean", "description": "Tandai menu populer" },
        "badge": { "type": "string", "description": "Label badge", "maxLength": 30 },
        "stockCount": { "type": "number", "description": "Jumlah sisa porsi stok" },
        "options": {
          "type": "array",
          "description": "Pilihan ekstra topping"
        }
      },
      "required": ["id", "name", "category", "price", "isAvailable"]
    },
    "Order": {
      "title": "Order",
      "description": "Catatan transaksi dan pesanan pelanggan Jajanan Kakang.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID pesanan unik, misal JK-9104" },
        "customerName": { "type": "string", "description": "Nama pemesan", "maxLength": 100 },
        "customerPhone": { "type": "string", "description": "Nomor WhatsApp pemesan", "maxLength": 20 },
        "orderType": { "type": "string", "enum": ["dine-in", "takeaway", "delivery"] },
        "tableOrAddress": { "type": "string", "description": "Alamat pengantaran atau nomor meja", "maxLength": 300 },
        "items": { "type": "array", "description": "Daftar item pesanan" },
        "subtotal": { "type": "number", "description": "Subtotal sebelum ongkir" },
        "deliveryFee": { "type": "number", "description": "Biaya ongkir" },
        "discount": { "type": "number", "description": "Potongan diskon" },
        "total": { "type": "number", "description": "Total tagihan akhir" },
        "paymentMethod": { "type": "string", "enum": ["qris", "transfer", "cash"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "verified"] },
        "orderStatus": { "type": "string", "enum": ["menunggu", "diproses", "siap", "selesai", "dibatalkan"] },
        "createdAt": { "type": "string", "description": "Waktu pesanan dibuat ISO8601" },
        "notes": { "type": "string", "description": "Catatan khusus pembeli", "maxLength": 300 },
        "isCashierOrder": { "type": "boolean", "description": "Tanda pesanan kasir POS" },
        "deviceId": { "type": "string", "description": "ID unik perangkat pembeli (localStorage)" },
        "userId": { "type": "string", "description": "ID unik pengguna jika login Firebase Auth" }
      },
      "required": ["id", "customerName", "customerPhone", "orderType", "items", "total", "paymentMethod", "orderStatus"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Konfigurasi toko, logo kustom, dan nomor WhatsApp checkout.",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "phoneWhatsapp": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "isOpen": { "type": "boolean" },
        "deliveryFee": { "type": "number" },
        "freeDeliveryMin": { "type": "number" },
        "announcement": { "type": "string", "maxLength": 500 },
        "logoUrl": { "type": "string", "description": "URL atau data URI logo toko" },
        "qrisImageUrl": { "type": "string", "description": "URL atau data URI gambar barcode QRIS toko" },
        "bankAccount": { "type": "object", "description": "Info rekening bank" }
      },
      "required": ["storeName", "phoneWhatsapp"]
    }
  },
  "firestore": {
    "/menu/{menuId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Koleksi menu jajanan dengan status ketersediaan stok real-time"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Koleksi transaksi pesanan pelanggan"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Dokumen pengaturan profil toko, logo, dan WhatsApp"
    }
  }
}
